{
  "name": "user-management-flask",
  "version": "1.0.0",
  "private": true,
  "description": "Fullstack user management app built with Flask, SQLite, Vanilla TypeScript and Bootstrap.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint src vite.config.ts",
    "lint:fix": "eslint src vite.config.ts --fix",
    "validate": "yarn typecheck && yarn lint",
    "build": "yarn typecheck && vite build",
    "preview": "vite preview"
  },
  "repository": "git@github.com:dm-morozov/user-management-flask.git",
  "author": "dm-morozov <dem.morozov@gmail.com>",
  "license": "MIT",
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": ">=20.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bootstrap": "^5.2.11",
    "@types/node": "^26.4.0",
    "eslint": "^10.9.1",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2"
  },
  "dependencies": {
    "@popperjs/core": "^2.11.8",
    "bootstrap": "^5.3.8"
  }
}
